{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@tanstack/react-query": [
        "../web/node_modules/@tanstack/react-query"
      ],
      "react-router": [
        "../web/node_modules/react-router"
      ],
      "dayjs": [
        "../web/node_modules/dayjs"
      ],
      "dayjs/*": [
        "../web/node_modules/dayjs/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
